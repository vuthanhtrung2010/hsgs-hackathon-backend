generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CanvasUser {
  id           Int           @id @default(autoincrement())
  studentId    String
  name         String
  shortName    String
  courseId     String
  rating       Float         @default(1500)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  quizzes      Quiz[]
  topicRatings TopicRating[]

  @@unique([studentId, courseId])
  @@index([courseId])
  @@index([studentId])
  @@index([studentId, courseId], map: "idx_users_student_course")
  @@map("users")
}

model Question {
  id              Int      @id @default(autoincrement())
  quizId          String
  quizName        String
  courseId        String
  types           String[]
  lesson          String?
  difficulty      Float?
  class           Int?
  rating          Float    @default(1500)
  submissionCount Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  quizzes         Quiz[]

  @@unique([quizId, courseId])
  @@index([courseId])
  @@index([quizId])
  @@index([courseId, quizId], map: "idx_questions_course_quiz")
  @@map("questions")
}

model Quiz {
  id           Int        @id @default(autoincrement())
  userId       Int
  questionId   Int
  submissionId String     @unique
  score        Float
  maxScore     Float
  submittedAt  DateTime
  ratingChange Float      @default(0)
  createdAt    DateTime   @default(now())
  question     Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user         CanvasUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
  @@index([questionId])
  @@index([userId, questionId], map: "idx_quizzes_user_question")
  @@index([userId, questionId], map: "idx_quizzes_userid_include")
  @@map("quizzes")
}

model Course {
  randomId  String   @unique @default(cuid())
  id        String   @id
  name      String
  quote     String?  @default("Thi đua là yêu nước, yêu nước phải thi đua - Bác Hồ")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("courses")
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("announcements")
}

model SyncHistory {
  id        Int      @id @default(autoincrement())
  courseId  String   @unique
  lastSync  DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId], map: "idx_sync_history_course")
  @@map("sync_history")
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  accounts      Account[]
  sessions      Session[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

model TopicRating {
  id              Int        @id @default(autoincrement())
  topic           String
  userId          Int
  courseId        String
  rating          Float      @default(1500)
  submissionCount Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  user            CanvasUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([topic, userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("topic_ratings")
}
